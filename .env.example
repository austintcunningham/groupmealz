# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (embedded checkout + saved cards)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email — customer receipts + restaurant notifications (https://resend.com)
# Verify your domain in Resend; EMAIL_FROM must use that domain in production.
RESEND_API_KEY=
EMAIL_FROM=orders@yourdomain.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron — lunch announcement sender (Vercel adds Authorization header on cron when set)
CRON_SECRET=

# Optional — run migrations locally (Supabase → Settings → Database → Connection string URI)
# SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[PASSWORD]@...pooler.supabase.com:5432/postgres
