# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Dashboard → Developers → API keys (test mode)
# Publishable key goes here (safe for browser):
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret key goes here (server only — never commit):
STRIPE_SECRET_KEY=

# Webhook secret — from `stripe listen` output (local dev) or Stripe Dashboard (production)
STRIPE_WEBHOOK_SECRET=

# Local app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
