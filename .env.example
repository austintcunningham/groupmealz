# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (embedded checkout + saved cards)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email — restaurant order notifications (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=orders@groupmealz.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — run migrations locally (Supabase → Settings → Database → Connection string URI)
# SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[PASSWORD]@...pooler.supabase.com:5432/postgres
