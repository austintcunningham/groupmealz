{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/send-lunch-announcements",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/send-review-requests",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/send-daily-fulfillment",
      "schedule": "30 14,15 * * *"
    },
    {
      "path": "/api/cron/send-weekly-digest",
      "schedule": "0 13,14 * * 1"
    }
  ]
}
